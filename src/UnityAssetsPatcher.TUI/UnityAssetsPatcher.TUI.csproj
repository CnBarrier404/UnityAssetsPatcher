<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-preview.6.26359.118"/>
        <PackageReference Include="Terminal.Gui" Version="2.4.18-develop.6"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\UnityAssetsPatcher.Application\UnityAssetsPatcher.Application.csproj"/>
        <ProjectReference Include="..\UnityAssetsPatcher.LocalizationGenerator\UnityAssetsPatcher.LocalizationGenerator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"
                          GlobalPropertiesToRemove="PublishAot"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Localization\JSON\*.json"/>
        <AdditionalFiles Include="Localization\JSON\*.json"/>
    </ItemGroup>

</Project>
