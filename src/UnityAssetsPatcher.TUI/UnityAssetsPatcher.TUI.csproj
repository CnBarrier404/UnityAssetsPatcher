<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-preview.5.26302.115"/>
        <PackageReference Include="Spectre.Console" Version="0.57.1-alpha.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\UnityAssetsPatcher.Application\UnityAssetsPatcher.Application.csproj"/>
        <ProjectReference Include="..\UnityAssetsPatcher.Core\UnityAssetsPatcher.Core.csproj"/>
        <ProjectReference Include="..\UnityAssetsPatcher.LocalizationGenerator\UnityAssetsPatcher.LocalizationGenerator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"
                          GlobalPropertiesToRemove="PublishAot"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Localization\JSON\*.json"/>
        <AdditionalFiles Include="Localization\JSON\*.json"/>
    </ItemGroup>

</Project>
