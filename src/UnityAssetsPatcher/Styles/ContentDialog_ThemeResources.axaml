<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ContentDialogForeground" Color="#E4000000" />
                    <SolidColorBrush x:Key="ContentDialogBackground" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#66757575" />
                    <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#0F000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ContentDialogForeground" Color="White" />
                    <SolidColorBrush x:Key="ContentDialogBackground" Color="#202020" />
                    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#66757575" />
                    <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#19000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#4D000000" />
            <x:Double x:Key="ContentDialogMinWidth">320</x:Double>
            <x:Double x:Key="ContentDialogMaxWidth">548</x:Double>
            <x:Double x:Key="ContentDialogMinHeight">184</x:Double>
            <x:Double x:Key="ContentDialogMaxHeight">756</x:Double>
            <x:Double x:Key="ContentDialogButtonSpacing">8</x:Double>
            <Thickness x:Key="ContentDialogPadding">24</Thickness>
            <Thickness x:Key="ContentDialogTitleMargin">0,0,0,12</Thickness>
            <Thickness x:Key="ContentDialogBorderWidth">1</Thickness>
            <Thickness x:Key="ContentDialogSeparatorThickness">0,0,0,1</Thickness>
            <CornerRadius x:Key="ContentDialogCornerRadius">8</CornerRadius>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Border.contentDialog">
        <Setter Property="MinWidth" Value="{StaticResource ContentDialogMinWidth}" />
        <Setter Property="MaxWidth" Value="{StaticResource ContentDialogMaxWidth}" />
        <Setter Property="MinHeight" Value="{StaticResource ContentDialogMinHeight}" />
        <Setter Property="MaxHeight" Value="{StaticResource ContentDialogMaxHeight}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ContentDialogBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContentDialogBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource ContentDialogBorderWidth}" />
        <Setter Property="CornerRadius" Value="{StaticResource ContentDialogCornerRadius}" />
    </Style>

    <Style Selector="Border.contentDialogContent">
        <Setter Property="Padding" Value="{StaticResource ContentDialogPadding}" />
        <Setter Property="Background" Value="{DynamicResource ContentDialogTopOverlay}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContentDialogSeparatorBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource ContentDialogSeparatorThickness}" />
    </Style>

    <Style Selector="TextBlock.contentDialogTitle">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ContentDialogForeground}" />
        <Setter Property="Margin" Value="{StaticResource ContentDialogTitleMargin}" />
    </Style>

    <Style Selector="TextBlock.contentDialogMessage">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource ContentDialogForeground}" />
    </Style>

    <Style Selector="Grid.contentDialogCommands">
        <Setter Property="Margin" Value="{StaticResource ContentDialogPadding}" />
    </Style>

    <Style Selector="Button.contentDialogButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
</Styles>
