<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.Avalonia;assembly=ResXLocalization.Avalonia"
             xmlns:res="using:UnityAssetsPatcher.Localization"
             xmlns:pages="using:UnityAssetsPatcher.ViewModels.Pages"
             x:Class="UnityAssetsPatcher.Views.InstallModPage"
             x:DataType="pages:InstallModPageViewModel">
    <Grid>
        <Grid IsVisible="{Binding IsDropZoneVisible}"
              RowDefinitions="Auto,*"
              RowSpacing="{StaticResource PageSectionSpacing}">
            <StackPanel Spacing="{StaticResource PageHeaderSpacing}">
                <TextBlock Classes="pageTitle"
                           AutomationProperties.HeadingLevel="1"
                           Text="{l:Localize {x:Static res:StringsKeys.MainMenu_InstallMod_Title}}" />
                <TextBlock Classes="body secondary" TextWrapping="Wrap"
                           Text="{l:Localize {x:Static res:StringsKeys.InstallPage_DropDescription}}" />
            </StackPanel>

            <Border x:Name="DropZone"
                    Grid.Row="1"
                    Classes="dropZone"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragEnter="OnDragEnter"
                    DragDrop.DragLeave="OnDragLeave"
                    DragDrop.DragOver="OnDragOver"
                    DragDrop.Drop="OnDrop"
                    IsHitTestVisible="{Binding IsNotBusy}"
                    AutomationProperties.AccessibilityView="Control"
                    AutomationProperties.AutomationId="InstallModDropZone"
                    AutomationProperties.HelpText="{l:Localize {x:Static res:StringsKeys.InstallPage_DropDescription}}"
                    AutomationProperties.Name="{l:Localize {x:Static res:StringsKeys.InstallPage_DropZoneName}}">
                <Grid Classes="dropZoneContent">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsNotBusy}"
                                Spacing="{StaticResource ControlGroupSpacing}">
                        <StackPanel Classes="dropDefaultContent"
                                    Spacing="{StaticResource ControlGroupSpacing}">
                            <TextBlock Classes="bodyLarge"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Text="{l:Localize {x:Static res:StringsKeys.InstallPage_DropPrompt}}" />
                            <Button AutomationProperties.AutomationId="InstallModSelectFileButton"
                                    Classes="accent"
                                    Click="OnSelectFileClick"
                                    Content="{l:Localize {x:Static res:StringsKeys.InstallPage_SelectFileButton}}"
                                    HorizontalAlignment="Center" />
                            <TextBlock Classes="caption secondary"
                                       TextAlignment="Center"
                                       Text="{l:Localize {x:Static res:StringsKeys.InstallPage_SupportedFormats}}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Classes="bodyLarge dragPrompt"
                               AutomationProperties.LiveSetting="Polite"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{l:Localize {x:Static res:StringsKeys.InstallPage_DragOverPrompt}}" />
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsBusy}"
                                Spacing="{StaticResource ContentGroupSpacing}">
                        <Border Classes="loadingIndicator"
                                HorizontalAlignment="Center">
                            <Border.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Border.RenderTransform>
                            <Path Classes="loadingIndicatorGlyph"
                                  AutomationProperties.AccessibilityView="Raw" />
                        </Border>
                        <TextBlock Classes="body secondary"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="{l:Localize {x:Static res:StringsKeys.InstallPage_Loading}}"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <Grid IsVisible="{Binding IsPreviewVisible}"
              RowDefinitions="Auto,Auto,Auto"
              RowSpacing="{StaticResource PageSectionSpacing}">
            <StackPanel Spacing="{StaticResource PageHeaderSpacing}">
                <TextBlock Classes="pageTitle"
                           AutomationProperties.HeadingLevel="1"
                           Text="{l:Localize {x:Static res:StringsKeys.MainMenu_InstallMod_Title}}" />
                <TextBlock Classes="body secondary"
                           TextWrapping="Wrap"
                           Text="{l:Localize {x:Static res:StringsKeys.InstallPage_PreviewDescription}}" />
            </StackPanel>

            <Border Grid.Row="1" Classes="card">
                <StackPanel Spacing="{StaticResource ContentGroupSpacing}">
                    <TextBlock Classes="bodyStrong"
                               AutomationProperties.HeadingLevel="2"
                               Text="{l:Localize {x:Static res:StringsKeys.InstallPage_ModInfoLabel}}" />
                    <StackPanel Spacing="{StaticResource ControlGroupSpacing}">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="{StaticResource MetadataColumnSpacing}">
                            <TextBlock Classes="subtitle"
                                       Text="{Binding ModName}"
                                       TextWrapping="Wrap" />
                            <Border Grid.Column="1"
                                    Classes="badge"
                                    VerticalAlignment="Top"
                                    Margin="0,4,0,0">
                                <TextBlock Classes="caption"
                                           Text="{Binding ModVersion}" />
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="{StaticResource LabelValueSpacing}">
                            <TextBlock Classes="body secondary"
                                       Text="{l:Localize {x:Static res:StringsKeys.InstallPage_AuthorLabel}}" />
                            <TextBlock Grid.Column="1"
                                       Classes="body secondary"
                                       Text="{Binding ModAuthor}"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Classes="body secondary"
                                   IsVisible="{Binding HasModDescription}"
                                   Text="{Binding ModDescription}"
                                   TextWrapping="Wrap" />
                        <TextBlock Classes="caption secondary"
                                   Text="{Binding PackageFileName}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Classes="divider" />

                    <StackPanel Spacing="{StaticResource ControlGroupSpacing}">
                        <TextBlock Classes="bodyStrong"
                                   AutomationProperties.HeadingLevel="2"
                                   Text="{l:Localize {x:Static res:StringsKeys.InstallPage_TargetGameLabel}}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource ActionColumnSpacing}">
                            <StackPanel
                                Spacing="{StaticResource TightContentSpacing}"
                                VerticalAlignment="Center">
                                <TextBlock Classes="body"
                                           Text="{Binding TargetGameName}"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="body secondary"
                                           Text="{Binding TargetGameDirectory}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    AutomationProperties.AutomationId="InstallModChangeGameDirectoryButton"
                                    Classes="subtle"
                                    Click="OnChangeGameDirectoryClick"
                                    Content="{l:Localize {x:Static res:StringsKeys.InstallPage_ChangeButton}}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasOptionalGroups}" Spacing="{StaticResource ContentGroupSpacing}">
                        <Border Classes="divider" />
                        <StackPanel Spacing="{StaticResource SectionHeadingToContentSpacing}">
                            <TextBlock Classes="bodyStrong"
                                       AutomationProperties.HeadingLevel="2"
                                       Text="{l:Localize {x:Static res:StringsKeys.InstallPage_OptionalContentLabel}}" />
                            <ItemsControl ItemsSource="{Binding OptionalGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pages:InstallOptionalGroupViewModel">
                                        <Border Classes="listItem">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Click="OnOptionalGroupClick"
                                                      IsEnabled="{Binding $parent[ItemsControl].((pages:InstallModPageViewModel)DataContext).IsNotBusy}">
                                                <StackPanel Margin="{StaticResource CheckBoxContentMargin}"
                                                            Spacing="{StaticResource TightContentSpacing}">
                                                    <TextBlock Classes="body"
                                                               Text="{Binding Name}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Classes="caption secondary"
                                                               IsVisible="{Binding HasDescription}"
                                                               Text="{Binding Description}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Spacing="{StaticResource ContentGroupSpacing}">
                <TextBlock Classes="body secondary"
                           AutomationProperties.LiveSetting="Polite"
                           IsVisible="{Binding IsPreviewBusy}"
                           Text="{l:Localize {x:Static res:StringsKeys.InstallPage_Loading}}" />
                <StackPanel IsVisible="{Binding IsInstalling}" Spacing="{StaticResource ControlGroupSpacing}">
                    <ProgressBar IsIndeterminate="{Binding IsInstalling}"
                                 AutomationProperties.Name="{l:Localize {x:Static res:StringsKeys.InstallPage_Installing}}" />
                    <TextBlock Classes="body secondary"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap"
                               Text="{l:Localize {x:Static res:StringsKeys.InstallPage_Installing}}" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="{StaticResource ControlGroupSpacing}">
                    <Button AutomationProperties.AutomationId="InstallModReselectButton"
                            Classes="subtle"
                            IsEnabled="{Binding CanReselect}"
                            Click="OnReselectClick"
                            Content="{l:Localize {x:Static res:StringsKeys.InstallPage_ReselectButton}}" />
                    <Button AutomationProperties.AutomationId="InstallModStartButton"
                            Classes="accent"
                            Click="OnStartInstallClick"
                            IsEnabled="{Binding IsNotBusy}"
                            Content="{l:Localize {x:Static res:StringsKeys.InstallPage_StartInstallButton}}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid IsVisible="{Binding IsCompleteVisible}"
              RowDefinitions="Auto,Auto,Auto"
              RowSpacing="{StaticResource PageSectionSpacing}">
            <StackPanel Spacing="{StaticResource PageHeaderSpacing}">
                <TextBlock Classes="pageTitle"
                           AutomationProperties.HeadingLevel="1"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{l:Localize {x:Static res:StringsKeys.InstallPage_CompleteTitle}}" />
                <TextBlock Classes="body secondary"
                           TextWrapping="Wrap"
                           Text="{l:Localize {x:Static res:StringsKeys.InstallPage_CompleteDescription}}" />
            </StackPanel>

            <Border Grid.Row="1" Classes="card">
                <StackPanel Spacing="{StaticResource ContentGroupSpacing}">
                    <TextBlock Classes="bodyStrong"
                               AutomationProperties.HeadingLevel="2"
                               Text="{l:Localize {x:Static res:StringsKeys.InstallPage_ModInfoLabel}}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource MetadataColumnSpacing}">
                        <TextBlock Classes="subtitle" Text="{Binding ModName}" TextWrapping="Wrap" />
                        <Border Grid.Column="1" Classes="badge" VerticalAlignment="Top" Margin="0,4,0,0">
                            <TextBlock Classes="caption" Text="{Binding ModVersion}" />
                        </Border>
                    </Grid>
                    <Border Classes="divider" />
                    <StackPanel Spacing="{StaticResource ControlGroupSpacing}">
                        <TextBlock Classes="bodyStrong"
                                   AutomationProperties.HeadingLevel="2"
                                   Text="{l:Localize {x:Static res:StringsKeys.InstallPage_TargetGameLabel}}" />
                        <StackPanel Spacing="{StaticResource TightContentSpacing}">
                            <TextBlock Classes="body" Text="{Binding TargetGameName}" TextWrapping="Wrap" />
                            <TextBlock Classes="body secondary" Text="{Binding TargetGameDirectory}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding HasInstalledOptionalGroups}"
                                Spacing="{StaticResource ContentGroupSpacing}">
                        <Border Classes="divider" />
                        <TextBlock Classes="bodyStrong"
                                   AutomationProperties.HeadingLevel="2"
                                   Text="{l:Localize {x:Static res:StringsKeys.InstallPage_InstalledOptionalContentLabel}}" />
                        <ItemsControl ItemsSource="{Binding InstalledOptionalGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="listItem">
                                        <TextBlock Classes="body" Text="{Binding}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Grid.Row="2"
                    AutomationProperties.AutomationId="InstallModContinueButton"
                    Classes="accent"
                    HorizontalAlignment="Right"
                    Click="OnReselectClick"
                    Content="{l:Localize {x:Static res:StringsKeys.InstallPage_ContinueButton}}" />
        </Grid>
    </Grid>
</UserControl>
