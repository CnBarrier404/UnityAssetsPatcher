<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <Thickness x:Key="PageContentPadding">32,24</Thickness>
            <Thickness x:Key="CardPadding">16</Thickness>
            <Thickness x:Key="ListItemPadding">8,4</Thickness>
            <Thickness x:Key="CheckBoxContentMargin">8,0,0,0</Thickness>
            <Thickness x:Key="BadgePadding">7,2</Thickness>
            <Thickness x:Key="DropZonePadding">20</Thickness>

            <x:Double x:Key="PageSectionSpacing">20</x:Double>
            <x:Double x:Key="PageHeaderSpacing">12</x:Double>
            <x:Double x:Key="SectionHeadingToContentSpacing">12</x:Double>
            <x:Double x:Key="ContentGroupSpacing">12</x:Double>
            <x:Double x:Key="ControlGroupSpacing">8</x:Double>
            <x:Double x:Key="TightContentSpacing">4</x:Double>
            <x:Double x:Key="InlineTextSpacing">2</x:Double>
            <x:Double x:Key="MetadataColumnSpacing">8</x:Double>
            <x:Double x:Key="LabelValueSpacing">12</x:Double>
            <x:Double x:Key="ActionColumnSpacing">8</x:Double>

            <x:Double x:Key="DropZoneMinHeight">300</x:Double>
            <x:Double x:Key="LoadingIndicatorSize">52</x:Double>
            <x:Double x:Key="LoadingIndicatorGlyphSize">42</x:Double>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="ScrollViewer.pageHost">
        <Setter Property="Padding" Value="{StaticResource PageContentPadding}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="ContentControl.pageContent">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlTransientBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessThin}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
        <Setter Property="Padding" Value="{StaticResource BadgePadding}" />
    </Style>
    <Style Selector="Border.divider">
        <Setter Property="Height" Value="{StaticResource StrokeThicknessThin}" />
        <Setter Property="Background" Value="{DynamicResource SystemControlTransientBorderBrush}" />
    </Style>
    <Style Selector="Border.listItem">
        <Setter Property="Padding" Value="{StaticResource ListItemPadding}" />
    </Style>

    <Style Selector="Border.dropZone">
        <Setter Property="Background" Value="{DynamicResource SystemControlTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlTransientBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessThin}" />
        <Setter Property="Padding" Value="{StaticResource DropZonePadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLarge}" />
    </Style>
    <Style Selector="Border.dropZone.drag-over">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
    </Style>
    <Style Selector="Border.dropZone.drag-invalid">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
    </Style>
    <Style Selector="Grid.dropZoneContent">
        <Setter Property="MinHeight" Value="{StaticResource DropZoneMinHeight}" />
    </Style>
    <Style Selector="StackPanel.dropDefaultContent">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="TextBlock.dragPrompt">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TextBlock.invalidDragPrompt">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.dropZone.drag-over StackPanel.dropDefaultContent">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.dropZone.drag-over TextBlock.dragPrompt">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.dropZone.drag-invalid StackPanel.dropDefaultContent">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.dropZone.drag-invalid TextBlock.invalidDragPrompt">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Border.loadingIndicator">
        <Setter Property="Width" Value="{StaticResource LoadingIndicatorSize}" />
        <Setter Property="Height" Value="{StaticResource LoadingIndicatorSize}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Style.Animations>
            <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Path.loadingIndicatorGlyph">
        <Setter Property="Width" Value="{StaticResource LoadingIndicatorGlyphSize}" />
        <Setter Property="Height" Value="{StaticResource LoadingIndicatorGlyphSize}" />
        <Setter Property="Data" Value="M21,3 A18,18 0 1 1 8.27,8.27" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
