<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.Avalonia;assembly=ResXLocalization.Avalonia"
             xmlns:res="using:UnityAssetsPatcher.GUI.Localization"
             x:Class="UnityAssetsPatcher.GUI.Views.SettingsPage">
    <StackPanel Spacing="6">
        <TextBlock Classes="pageTitle"
                   AutomationProperties.HeadingLevel="1"
                   Text="{l:Localize {x:Static res:StringsKeys.MainMenu_Settings_Title}}" />
    </StackPanel>
</UserControl>
