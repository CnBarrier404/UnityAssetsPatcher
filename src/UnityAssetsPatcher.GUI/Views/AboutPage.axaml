<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.Avalonia;assembly=ResXLocalization.Avalonia"
             xmlns:res="using:UnityAssetsPatcher.GUI.Localization"
             x:Class="UnityAssetsPatcher.GUI.Views.AboutPage">
    <StackPanel Spacing="{StaticResource PageHeaderSpacing}">
        <TextBlock Classes="pageTitle"
                   AutomationProperties.HeadingLevel="1"
                   Text="{l:Localize {x:Static res:StringsKeys.Navigation_About}}" />
    </StackPanel>
</UserControl>
