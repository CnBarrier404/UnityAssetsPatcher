<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UnityAssetsPatcher.GUI.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <FontFamily x:Key="ContentControlThemeFontFamily">avares://UnityAssetsPatcher.GUI/Assets/Fonts/MiSans-Normal.otf#MiSans</FontFamily>
        <FontFamily x:Key="StrongTextFontFamily">avares://UnityAssetsPatcher.GUI/Assets/Fonts/MiSans-Normal.otf#MiSans</FontFamily>
        <FontWeight x:Key="StrongTextFontWeight">305</FontWeight>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://UnityAssetsPatcher.GUI/Styles/DesignTokens.axaml" />
        <StyleInclude Source="avares://UnityAssetsPatcher.GUI/Styles/Typography.axaml" />
        <StyleInclude Source="avares://UnityAssetsPatcher.GUI/Styles/Button_ThemeResources.axaml" />
        <StyleInclude Source="avares://UnityAssetsPatcher.GUI/Styles/Components.axaml" />
    </Application.Styles>
</Application>
